# Referencia de variables (Spring NO carga este archivo: configurarlas en IntelliJ o en Parameter Store)

# Base de datos (Supabase / PostgreSQL)
# El host directo (db.<ref>.supabase.co) es solo IPv6; en redes sin IPv6 (incluye la fundacion)
# usar el Session Pooler (IPv4) con usuario postgres.<project-ref>:
DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.ubqgnwfcprzdigwwukmm
DB_PASSWORD=

# AWS Cognito (deploy/cognito-setup.ps1 imprime estos valores)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>

# Datos semilla ficticios (proyectos, eventos, participantes) si la base no tiene proyectos
SYNCPASS_DATOS_SEMILLA=true

# AWS credentials (en EC2 usar rol IAM de la instancia; localmente usar perfil/default chain)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CORS: orígenes permitidos para el front (Vercel), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<tu-dominio-vercel>.vercel.app
