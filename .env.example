# Referencia de variables (Spring NO carga este archivo: configurarlas en IntelliJ o en Parameter Store)

# Base de datos (Supabase / PostgreSQL, Session pooler)
DB_URL=jdbc:postgresql://<host-session-pooler>:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=

# AWS Cognito (deploy/cognito-setup.ps1 imprime estos valores)
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/<user-pool-id>

# Datos semilla ficticios (proyectos, eventos, participantes) si la base no tiene proyectos
SYNCPASS_DATOS_SEMILLA=true

# AWS credentials (en EC2 usar rol IAM de la instancia; localmente usar perfil/default chain)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
